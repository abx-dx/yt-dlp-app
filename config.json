{
  "ytdlp": "./bin/yt-dlp.exe",

  "output": "./downloads/%(artist,uploader)s - %(title)s.%(ext)s",

  "cookies": {
    "enabled": true,
    "browser": "firefox"
  },

  "aria2": "./bin/aria2c.exe",

  "profiles": {

    "video": {
      "format": "bestvideo+bestaudio/best",
      "output": "./downloads/%(title)s.%(ext)s",
      "args": [
        "--merge-output-format",
        "mkv"
      ]
    },

    "audio": {
      "format": "bestaudio[acodec=opus]/bestaudio",
      "args": [
        "--remux-video",
        "opus",
        "--embed-metadata",
        "--embed-thumbnail"
      ]
    },

    "playlist": {
      "format": "bestaudio[acodec=opus]/bestaudio",
      "playlist": true,
      "args": [
        "--yes-playlist",
        "--remux-video",
        "opus",
        "--embed-metadata",
        "--embed-thumbnail"
      ]
    }

  }
}